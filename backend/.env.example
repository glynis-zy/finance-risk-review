# 复制为 .env 后填写。厂商可换，只改这里。
# 本机 MySQL 账号（atguigu / Atguigu.123）；若用其他账号改这里即可
DATABASE_URL=mysql+pymysql://atguigu:Atguigu.123@127.0.0.1:3306/finance_risk?charset=utf8mb4

JWT_SECRET=finance-risk-review-demo-secret-key-2026-change-me
